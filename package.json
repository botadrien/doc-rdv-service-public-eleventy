{
  "name": "doc-rdv-service-public-eleventy",
  "version": "1.0.0",
  "description": "Site d'aide de RDV Service Public — Eleventy + Système de Design de l'État (DSFR).",
  "scripts": {
    "build": "npx @11ty/eleventy",
    "postbuild": "npx pagefind --site _site/ --output-subdir \"_pagefind\"",
    "build-ghpages": "npx @11ty/eleventy --pathprefix=/doc-rdv-service-public-eleventy/ && npx pagefind --site _site/ --output-subdir \"_pagefind\"",
    "start": "npx @11ty/eleventy --serve --quiet",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botadrien/doc-rdv-service-public-eleventy.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-bundle": "^1.0.5",
    "@gouvfr/dsfr": "^1.11.2",
    "@sindresorhus/slugify": "1.1.2",
    "esbuild": "^0.24.0",
    "luxon": "^3.5.0",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-container": "^4.0.0",
    "pagefind": "^1.2.0"
  }
}
