{
  "name": "doc-rdv-service-public-eleventy",
  "version": "1.0.0",
  "description": "Site d'aide de RDV Service Public — Eleventy + Système de Design de l'État (DSFR).",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test test/*.test.js packages/*/test/*.test.js",
    "prebuild": "npm run admin:build",
    "build": "npx @11ty/eleventy",
    "postbuild": "npx pagefind --site _site/ --output-subdir \"_pagefind\"",
    "prebuild-ghpages": "npm run admin:build",
    "build-ghpages": "npx @11ty/eleventy --pathprefix=/doc-rdv-service-public-eleventy/ && npx pagefind --site _site/ --output-subdir \"_pagefind\"",
    "start": "npx @11ty/eleventy --serve --quiet",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "admin:dev": "vite --config admin-src/vite.config.ts",
    "admin:build": "vite build --config admin-src/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botadrien/doc-rdv-service-public-eleventy.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "comments": {
    "overrides": "Le lot Decap publié le 2026-09-08 (*.1) référence des versions pnpm `catalog:` non résolues -> npm 10 refuse d'installer. On épingle les 5 paquets touchés à leur dernier patch sain (*.0). À retirer quand l'upstream corrige. cf. docs/remplacer-editeur-cms-dsfr-editor.md."
  },
  "overrides": {
    "decap-cms-lib-util": "3.8.0",
    "decap-cms-lib-auth": "3.3.0",
    "decap-cms-lib-widgets": "3.4.0",
    "decap-cms-editor-component-image": "3.4.0",
    "decap-cms-default-exports": "3.3.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-bundle": "^1.0.5",
    "@blocknote/ariakit": "0.54.0",
    "@blocknote/core": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@codegouvfr/react-dsfr": "^1.34.0",
    "@gouvfr/dsfr": "^1.11.2",
    "@sindresorhus/slugify": "1.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "decap-cms-app": "^3.16.1",
    "dsfr-editor": "*",
    "esbuild": "^0.24.0",
    "luxon": "^3.5.0",
    "markdown-it": "14.1.0",
    "markdown-it-dsfr": "*",
    "pagefind": "^1.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
